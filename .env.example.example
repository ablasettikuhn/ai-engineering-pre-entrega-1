# Copia este archivo como .env y completa tus claves. NUNCA subas el .env a GitHub.

# Orden de prioridad: se prueba Claude primero y, si falla, Gemini.
LLM_PROVIDERS=anthropic,gemini

# Claves de API
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Modelos (opcional: estos son los valores por defecto)
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.1-flash-lite

# Parámetros de generación (validados con Pydantic)
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.7    # opcional, de 0 a 2. Claude la ignora.
